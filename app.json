{
  "expo": {
    "name": "Edy Alinhamentos",
    "slug": "edy-alinhamentos-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.edyalinhamentos.app"
    },
    "android": {
      "package": "br.com.edyalinhamentos.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F26A1B"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8265ddae-5903-433e-85aa-f8bcd35ff285"
      }
    },
    "owner": "abrantesleandro"
  }
}
